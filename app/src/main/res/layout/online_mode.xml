<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/join">

    <TextView
        android:id="@+id/enterHostPromptOutline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Testing REST to server for now"
        android:textAlignment="center"
        android:textColor="@android:color/black"
        android:textSize="25sp"
        app:layout_constraintBottom_toBottomOf="@+id/enterHostPrompt"
        app:layout_constraintEnd_toEndOf="@+id/enterHostPrompt"
        app:layout_constraintStart_toStartOf="@+id/enterHostPrompt"
        app:layout_constraintTop_toTopOf="@+id/enterHostPrompt" />

    <TextView
        android:id="@+id/enterHostPrompt"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Testing REST to server for now"
        android:textAlignment="center"
        android:textColor="@android:color/white"
        android:textSize="25sp"
        app:layout_constraintBottom_toTopOf="@+id/scrollView3"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.25" />

    <Button
        android:id="@+id/join"
        android:layout_width="250dp"
        android:layout_height="50dp"
        android:background="@drawable/button_states"
        android:onClick="sendTestREST"
        android:text="Send Request"
        android:textColor="@android:color/white"
        android:textSize="18sp"
        app:layout_constraintBottom_toBottomOf="@+id/btnGetList"
        app:layout_constraintStart_toStartOf="parent" />

    <Button
        android:id="@+id/toMainMenu"
        android:layout_width="150dp"
        android:layout_height="40dp"
        android:layout_marginStart="10dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/button_states"
        android:onClick="toMainMenu"
        android:text="Back to Menu"
        android:textColor="@android:color/white"
        android:textSize="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/connectingLabel2"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="fitXY"
        app:srcCompat="@android:drawable/screen_background_dark_transparent"
        tools:layout_editor_absoluteY="228dp" />

    <Button
        android:id="@+id/btnGetList"
        android:layout_width="250dp"
        android:layout_height="50dp"
        android:background="@drawable/button_states"
        android:onClick="getLobbyList"
        android:text="getLobbyList"
        android:textColor="@android:color/white"
        android:textSize="18sp"
        app:layout_constraintEnd_toEndOf="parent"
        tools:layout_editor_absoluteY="50dp" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layoutCreateLobby"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="@+id/scrollView3"
        app:layout_constraintEnd_toEndOf="@+id/scrollView3"
        app:layout_constraintStart_toStartOf="@+id/scrollView3"
        app:layout_constraintTop_toTopOf="@+id/scrollView3">

        <Button
            android:id="@+id/btnCreateLobby"
            android:layout_width="250dp"
            android:layout_height="50dp"
            android:background="@drawable/button_states"
            android:onClick="sendTestREST"
            android:text="Create Lobby"
            android:textColor="@android:color/white"
            android:textSize="18sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/editCreateLobbyName" />

        <ImageView
            android:id="@+id/imgCreateLobbyName"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:scaleType="fitXY"
            app:layout_constraintBottom_toBottomOf="@id/editCreateLobbyName"
            app:layout_constraintEnd_toEndOf="@id/editCreateLobbyName"
            app:layout_constraintStart_toStartOf="@id/editCreateLobbyName"
            app:layout_constraintTop_toTopOf="@id/editCreateLobbyName"
            app:srcCompat="@android:drawable/screen_background_dark_transparent"
            tools:layout_editor_absoluteX="318dp"
            tools:layout_editor_absoluteY="227dp" />

        <EditText
            android:id="@+id/editCreateLobbyName"
            android:layout_width="150dp"
            android:layout_height="40dp"
            android:ems="10"
            android:hint="Lobby Name"
            android:inputType="none"
            android:textAlignment="center"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <ScrollView
        android:id="@+id/scrollView3"
        android:layout_width="783dp"
        android:layout_height="291dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:id="@+id/layoutLobbies"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>